# Copy to .env.local and fill in. Never put real values in this file: it is committed.

# Admin login credentials (required). Use a long, unique password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign admin session cookies (required, at least 16 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out every admin session.
SESSION_SECRET=

# Pooled Postgres connection string from Neon / Vercel Postgres (required).
POSTGRES_URL=
