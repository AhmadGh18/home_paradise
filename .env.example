# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Must be at least 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-long-random-string-of-at-least-16-chars

# Optional: path to the SQLite database file (defaults to ./data.sqlite)
# DATABASE_FILE=./data.sqlite
